<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">gental.mcp.document.list</field>
        <field name="model">gental.mcp.document</field>
        <field name="arch" type="xml">
            <list string="Documents" create="0" delete="0" edit="0" default_order="id desc">
                <field name="name"/>
                <field name="tool"/>
                <field name="client_id"/>
                <field name="create_date" string="Created"/>
                <field name="expires_at"/>
                <field name="download_count"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-muted="state == 'expired'"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">gental.mcp.document.form</field>
        <field name="model">gental.mcp.document</field>
        <field name="arch" type="xml">
            <form string="Document" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tool"/>
                            <field name="client_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Created"/>
                            <field name="expires_at"/>
                            <field name="download_count"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="report_xmlid"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_search" model="ir.ui.view">
        <field name="name">gental.mcp.document.search</field>
        <field name="model">gental.mcp.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tool"/>
                <field name="client_id"/>
                <filter name="active_links" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired_links" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_documents" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">gental.mcp.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents yet</p>
            <p>PDFs that assistants make for you (quotations, invoices, delivery slips) will be listed here with their download links' expiry.</p>
        </field>
    </record>
</odoo>
