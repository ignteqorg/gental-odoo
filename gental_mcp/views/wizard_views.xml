<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_key_wizard_form" model="ir.ui.view">
        <field name="name">gental.mcp.api.key.wizard.form</field>
        <field name="model">gental.mcp.api.key.wizard</field>
        <field name="arch" type="xml">
            <form string="New API key">
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <field name="name" placeholder="Claude Desktop"/>
                    <field name="can_pick_user" invisible="1"/>
                    <field name="user_id" readonly="not can_pick_user" force_save="1"/>
                    <field name="expires_at"/>
                </group>
                <div invisible="state != 'done'">
                    <p class="text-muted">This key won't be shown again. Copy it now and keep it somewhere safe.</p>
                    <field name="key" widget="CopyClipboardChar" readonly="1"/>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Create key" class="btn-primary"
                            invisible="state == 'done'" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" invisible="state == 'done'" data-hotkey="x"/>
                    <button string="Done" special="cancel" class="btn-primary"
                            invisible="state != 'done'" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_api_key_wizard" model="ir.actions.act_window">
        <field name="name">New API key</field>
        <field name="res_model">gental.mcp.api.key.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_identity_secret_wizard_form" model="ir.ui.view">
        <field name="name">gental.mcp.identity.secret.wizard.form</field>
        <field name="model">gental.mcp.identity.secret.wizard</field>
        <field name="arch" type="xml">
            <form string="Set identity secret">
                <group>
                    <field name="secret" password="True" required="1"/>
                </group>
                <footer>
                    <button name="action_set" type="object" string="Save secret" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_identity_secret_wizard" model="ir.actions.act_window">
        <field name="name">Set identity secret</field>
        <field name="res_model">gental.mcp.identity.secret.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
