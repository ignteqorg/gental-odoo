<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_list" model="ir.ui.view">
        <field name="name">gental.mcp.client.list</field>
        <field name="model">gental.mcp.client</field>
        <field name="arch" type="xml">
            <tree string="Clients" create="0" decoration-muted="state == 'revoked'">
                <header>
                    <button name="%(action_api_key_wizard)d" type="action" string="New API key"
                            class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="kind" widget="badge"/>
                <field name="user_id"/>
                <field name="key_hint" optional="show"/>
                <field name="last_used_at"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-danger="state == 'revoked'"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"
                        invisible="state == 'revoked'"
                        confirm="Revoke this client? Everything it signed in with stops working right away."/>
            </tree>
        </field>
    </record>

    <record id="view_client_form" model="ir.ui.view">
        <field name="name">gental.mcp.client.form</field>
        <field name="model">gental.mcp.client</field>
        <field name="arch" type="xml">
            <form string="Client" create="0" delete="0">
                <header>
                    <button name="action_revoke" type="object" string="Revoke" class="btn-danger"
                            invisible="state == 'revoked'"
                            confirm="Revoke this client? Everything it signed in with stops working right away."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="key_hint" invisible="kind != 'api_key'"/>
                        </group>
                        <group>
                            <field name="last_used_at"/>
                            <field name="expires_at" readonly="1"/>
                            <field name="revoked_at"/>
                            <field name="registration" invisible="kind != 'oauth'"/>
                        </group>
                    </group>
                    <group invisible="kind != 'oauth'">
                        <field name="client_id" readonly="1"/>
                        <field name="redirect_uris" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_client_search" model="ir.ui.view">
        <field name="name">gental.mcp.client.search</field>
        <field name="model">gental.mcp.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="api_keys" string="API keys" domain="[('kind', '=', 'api_key')]"/>
                <filter name="oauth" string="OAuth" domain="[('kind', '=', 'oauth')]"/>
            </search>
        </field>
    </record>

    <record id="action_clients" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">gental.mcp.client</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No assistants connected yet</p>
            <p>Assistants that sign in with OAuth show up here. You can also create an API key for a user.</p>
        </field>
    </record>
</odoo>
