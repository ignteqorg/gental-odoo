<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The chatters of the module's forms, kept apart so the 17.0 tree overlays only this file (17.0 has no
         <chatter/> shorthand). -->
    <record id="view_config_form_chatter" model="ir.ui.view">
        <field name="name">gental.mcp.config.form.chatter</field>
        <field name="model">gental.mcp.config</field>
        <field name="inherit_id" ref="view_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="view_webhook_subscription_form_chatter" model="ir.ui.view">
        <field name="name">gental.mcp.webhook.subscription.form.chatter</field>
        <field name="model">gental.mcp.webhook.subscription</field>
        <field name="inherit_id" ref="view_webhook_subscription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>
</odoo>
