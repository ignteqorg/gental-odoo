<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay of gental_mcp/security/groups.xml for Odoo 17.0: res.groups.implied_by_ids is 19.0 only (port-notes
     B1), so base.group_system implies the manager group from its own side (implied_ids). -->
<odoo>
    <record id="group_mcp_connect" model="res.groups">
        <field name="name">Gental MCP: Connect</field>
        <field name="comment">Can connect AI assistants to Odoo and act through them with their own access rights.</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Gental MCP: Manager</field>
        <field name="comment">Manages clients, API keys, logs and settings of the MCP connection.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_mcp_connect'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_mcp_manager'))]"/>
    </record>
</odoo>
