<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay of gental_mcp/data/cron.xml for Odoo 17.0: ir.cron.numbercall defaults to 1 there, so each cron
     would run once and deactivate (port-notes S6). Same records plus numbercall=-1 and doall=False. -->
<odoo noupdate="1">
    <record id="cron_purge_logs" model="ir.cron">
        <field name="name">Gental MCP: purge old logs and expired tokens</field>
        <field name="model_id" ref="model_gental_mcp_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_purge_documents" model="ir.cron">
        <field name="name">Gental MCP: delete expired document files</field>
        <field name="model_id" ref="model_gental_mcp_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_documents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
